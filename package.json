	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"concurrently": "^10.0.5",
		"eslint": "^10.11.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.0"
